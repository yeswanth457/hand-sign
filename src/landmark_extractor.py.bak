"""
Phase 3: Video Preprocessing and Pose + Hand Landmark Extraction.
Uses MediaPipe Tasks / Solutions API with a robust fallback for raw video/canvas coordinates.
Extracts: Left/Right Wrist, Left/Right Elbow, Left/Right Shoulder, Hand Landmark arrays.
"""

import cv2
import numpy as np
from config import FRAME_WIDTH, FRAME_HEIGHT

try:
    import mediapipe as mp
    MP_AVAILABLE = True
except ImportError:
    MP_AVAILABLE = False


class LandmarkExtractor:
    def __init__(self, static_image_mode=False, max_num_hands=2, min_detection_confidence=0.5):
        self.mp_available = MP_AVAILABLE
        self.pose = None
        self.hands = None
        
        self.prev_frame_gray = None
        
        if self.mp_available:
            try:
                self.mp_pose = mp.solutions.pose
                self.mp_hands = mp.solutions.hands
                self.pose = self.mp_pose.Pose(
                    static_image_mode=static_image_mode,
                    min_detection_confidence=min_detection_confidence
                )
                self.hands = self.mp_hands.Hands(
                    static_image_mode=static_image_mode,
                    max_num_hands=max_num_hands,
                    min_detection_confidence=min_detection_confidence
                )
            except Exception as e:
                print(f"[LandmarkExtractor] MediaPipe init warning: {e}. Using fallback coordinate mode.")
                self.mp_available = False

    def reset(self):
        """Resets video frame tracking state for fallback mode."""
        self.prev_frame_gray = None

    def process_frame(self, frame_bgr):
        """
        Processes a single BGR video frame and extracts normalized keypoint coordinates.
        Returns dictionary containing:
        - pose_landmarks: Dict with LW, RW, LE, RE, LS, RS coordinates (x, y, z)
        - hand_landmarks: List of hand landmark dicts (21 points each)
        - hand_center: (hx, hy) dominant hand center position
        - shoulder_center: (sx, sy) midpoint between left and right shoulders
        """
        h, w, c = frame_bgr.shape
        rgb_frame = cv2.cvtColor(frame_bgr, cv2.COLOR_BGR2RGB)
        
        pose_res = None
        hands_res = None
        
        if self.mp_available and self.pose and self.hands:
            try:
                pose_res = self.pose.process(rgb_frame)
                hands_res = self.hands.process(rgb_frame)
            except Exception as e:
                pass

        # Extract Pose Joints (Left/Right Wrist, Elbow, Shoulder)
        pose_dict = {}
        if pose_res and pose_res.pose_landmarks:
            lms = pose_res.pose_landmarks.landmark
            pose_dict = {
                "LW": (lms[self.mp_pose.PoseLandmark.LEFT_WRIST].x, lms[self.mp_pose.PoseLandmark.LEFT_WRIST].y, lms[self.mp_pose.PoseLandmark.LEFT_WRIST].z),
                "RW": (lms[self.mp_pose.PoseLandmark.RIGHT_WRIST].x, lms[self.mp_pose.PoseLandmark.RIGHT_WRIST].y, lms[self.mp_pose.PoseLandmark.RIGHT_WRIST].z),
                "LE": (lms[self.mp_pose.PoseLandmark.LEFT_ELBOW].x, lms[self.mp_pose.PoseLandmark.LEFT_ELBOW].y, lms[self.mp_pose.PoseLandmark.LEFT_ELBOW].z),
                "RE": (lms[self.mp_pose.PoseLandmark.RIGHT_ELBOW].x, lms[self.mp_pose.PoseLandmark.RIGHT_ELBOW].y, lms[self.mp_pose.PoseLandmark.RIGHT_ELBOW].z),
                "LS": (lms[self.mp_pose.PoseLandmark.LEFT_SHOULDER].x, lms[self.mp_pose.PoseLandmark.LEFT_SHOULDER].y, lms[self.mp_pose.PoseLandmark.LEFT_SHOULDER].z),
                "RS": (lms[self.mp_pose.PoseLandmark.RIGHT_SHOULDER].x, lms[self.mp_pose.PoseLandmark.RIGHT_SHOULDER].y, lms[self.mp_pose.PoseLandmark.RIGHT_SHOULDER].z),
            }
        else:
            # Dynamic fallback estimation based on frame visual content & motion centroid
            cx, cy = 0.60, 0.65
            gray = cv2.cvtColor(frame_bgr, cv2.COLOR_BGR2GRAY)

            if hasattr(self, "prev_frame_gray") and self.prev_frame_gray is not None and self.prev_frame_gray.shape == gray.shape:
                diff = cv2.absdiff(gray, self.prev_frame_gray)
                _, diff_thresh = cv2.threshold(diff, 10, 255, cv2.THRESH_BINARY)
                M_diff = cv2.moments(diff_thresh)
                if M_diff["m00"] > 0:
                    cx = float((M_diff["m10"] / M_diff["m00"]) / max(1, w))
                    cy = float((M_diff["m01"] / M_diff["m00"]) / max(1, h))
                else:
                    _, thresh = cv2.threshold(gray, 15, 255, cv2.THRESH_BINARY)
                    M = cv2.moments(thresh)
                    if M["m00"] > 0:
                        cx = float((M["m10"] / M["m00"]) / max(1, w))
                        cy = float((M["m01"] / M["m00"]) / max(1, h))
            else:
                _, thresh = cv2.threshold(gray, 15, 255, cv2.THRESH_BINARY)
                M = cv2.moments(thresh)
                if M["m00"] > 0:
                    cx = float((M["m10"] / M["m00"]) / max(1, w))
                    cy = float((M["m01"] / M["m00"]) / max(1, h))

            self.prev_frame_gray = gray

            pose_dict = {
                "LW": (1.0 - cx, cy, 0.0),
                "RW": (cx, cy, 0.0),
                "LE": (0.5 * ((1.0 - cx) + 0.35), 0.5 * (cy + 0.50), 0.0),
                "RE": (0.5 * (cx + 0.65), 0.5 * (cy + 0.50), 0.0),
                "LS": (0.40, 0.35, 0.0),
                "RS": (0.60, 0.35, 0.0),
            }

        # Extract Hand Landmarks (21 points per hand)
        hands_list = []
        if hands_res and hands_res.multi_hand_landmarks:
            for hand_lms in hands_res.multi_hand_landmarks:
                pts = [(lm.x, lm.y, lm.z) for lm in hand_lms.landmark]
                hands_list.append(pts)

        # Dominant Hand Center Hx, Hy
        if hands_list and len(hands_list[0]) > 0:
            # Centroid of dominant hand keypoints
            pts = np.array(hands_list[0])
            hx, hy = np.mean(pts[:, 0]), np.mean(pts[:, 1])
        else:
            # Use Right/Left Wrist as hand center fallback
            hx, hy = pose_dict["RW"][0], pose_dict["RW"][1]

        # Shoulder Center Sx, Sy
        ls = pose_dict["LS"]
        rs = pose_dict["RS"]
        sx, sy = (ls[0] + rs[0]) / 2.0, (ls[1] + rs[1]) / 2.0

        return {
            "pose": pose_dict,
            "hands": hands_list,
            "hand_center": (float(hx), float(hy)),
            "shoulder_center": (float(sx), float(sy))
        }

    def process_raw_landmarks(self, pose_dict, hand_pts=None):
        """Processes pre-extracted numerical landmarks directly."""
        if hand_pts and len(hand_pts) > 0:
            pts = np.array(hand_pts)
            hx, hy = np.mean(pts[:, 0]), np.mean(pts[:, 1])
        elif "RW" in pose_dict:
            hx, hy = pose_dict["RW"][0], pose_dict["RW"][1]
        else:
            hx, hy = 0.5, 0.5

        ls = pose_dict.get("LS", (0.4, 0.35, 0))
        rs = pose_dict.get("RS", (0.6, 0.35, 0))
        sx, sy = (ls[0] + rs[0]) / 2.0, (ls[1] + rs[1]) / 2.0

        return {
            "pose": pose_dict,
            "hands": [hand_pts] if hand_pts else [],
            "hand_center": (float(hx), float(hy)),
            "shoulder_center": (float(sx), float(sy))
        }
